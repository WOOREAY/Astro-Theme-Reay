---
/**
 * Gallery Page
 * Content-driven plog album index.
 */
import EditorialPageLayout from '@app/layouts/base/EditorialPageLayout.astro';
import { getPlogGallery } from '@features/gallery/lib/plog';
import { useI18n } from '@features/i18n/lib/i18n';
import { getImage } from 'astro:assets';
import EditorialPageHeader from '@shared/components/EditorialPageHeader.astro';
import EditorialSectionHeader from '@shared/components/EditorialSectionHeader.astro';

const { t } = useI18n();
const sourceGalleryConfig = await getPlogGallery();

const optimizedImageCache = new Map<string, Promise<string>>();

function getOptimizedPlogImage(imageAsset: unknown, width: number, quality = 72) {
  if (!imageAsset || typeof imageAsset !== 'object' || !('src' in imageAsset)) {
    return Promise.resolve('');
  }

  const asset = imageAsset as Parameters<typeof getImage>[0]['src'];
  const cacheKey = `${(asset as { src?: string }).src ?? ''}:${width}:${quality}`;
  const cached = optimizedImageCache.get(cacheKey);

  if (cached) return cached;

  const request = getImage({
    src: asset,
    width,
    format: 'webp',
    quality,
  })
    .then(image => image.src)
    .catch(() => (asset as { src?: string }).src ?? '');

  optimizedImageCache.set(cacheKey, request);
  return request;
}

const albums = await Promise.all(sourceGalleryConfig.albums.map(async (album) => {
  const photos = await Promise.all(album.photos.map(async (photo, index) => ({
    ...photo,
    thumbnailImage: await getOptimizedPlogImage(photo.imageAsset, index === 0 ? 640 : 280, 66) || photo.image,
  })));

  return {
    ...album,
    coverImage: await getOptimizedPlogImage(album.coverAsset, 840, 68) || album.cover,
    photos,
  };
}));

const galleryConfig = {
  ...sourceGalleryConfig,
  albums,
  photos: albums.flatMap(album => album.photos),
};
const featuredAlbum = galleryConfig.albums.find(album => album.featured) ?? galleryConfig.albums[0];
const totalTags = new Set(galleryConfig.albums.flatMap(album => album.tags)).size;
const featuredPhotos = featuredAlbum?.photos.slice(0, 5) ?? [];
const headerStats = [
  { icon: 'i-carbon:image', labelKey: 'gallery.stats.photos', label: t('gallery.stats.photos'), value: galleryConfig.photos.length },
  { icon: 'i-carbon:folder', labelKey: 'gallery.stats.albums', label: t('gallery.stats.albums'), value: galleryConfig.albums.length },
  { icon: 'i-carbon:tag', labelKey: 'gallery.stats.tags', label: t('gallery.stats.tags'), value: totalTags },
];
---

<EditorialPageLayout title={t('page.title.gallery')} description={t('gallery.subtitle')} pageClass="gallery-index-layout">
  <div class="gallery-page">
    <EditorialPageHeader
      title={t('gallery.title')}
      description={t('gallery.subtitle')}
      titleKey="gallery.title"
      descriptionKey="gallery.subtitle"
      eyebrow={t('gallery.eyebrow')}
      eyebrowKey="gallery.eyebrow"
      icon="i-carbon:image"
      stats={headerStats}
    />

    {featuredAlbum && (
      <section class="featured-section" style={`--album-accent: ${featuredAlbum.accent};`}>
        <a class="featured-album" href={featuredAlbum.href} aria-label={`${t('gallery.viewAlbum')}: ${featuredAlbum.title}`}>
          <div class="featured-cover">
            {featuredAlbum.coverImage || featuredAlbum.cover ? (
              <img
                src={featuredAlbum.coverImage || featuredAlbum.cover}
                alt={featuredAlbum.coverAlt ?? featuredAlbum.title}
                loading="eager"
                decoding="async"
                fetchpriority="high"
                sizes="(max-width: 980px) 100vw, 720px"
              />
            ) : (
              <span class="image-fallback" style={`--fallback-bg: ${featuredAlbum.gradient};`}></span>
            )}
          </div>

          <div class="featured-content">
            <span class="featured-label" data-i18n="gallery.featuredAlbum">{t('gallery.featuredAlbum')}</span>
            <h2>{featuredAlbum.title}</h2>
            <p>{featuredAlbum.description}</p>
            <span class="featured-meta">
              <span><i class={featuredAlbum.icon}></i>{featuredAlbum.photoCount} {t('gallery.stats.photos')}</span>
              <span><i class="i-carbon:calendar"></i>{featuredAlbum.date}</span>
              <span><i class="i-carbon:location"></i>{featuredAlbum.location}</span>
            </span>
            <span class="featured-action">
              <span data-i18n="gallery.viewAlbum">{t('gallery.viewAlbum')}</span>
              <i class="i-carbon:arrow-right"></i>
            </span>
          </div>

          <div class="featured-strip" aria-hidden="true">
            {featuredPhotos.map(photo => (
              <span class="strip-frame">
                {photo.thumbnailImage || photo.image ? (
                  <img
                    src={photo.thumbnailImage || photo.image}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    sizes="120px"
                  />
                ) : (
                  <span class="image-fallback" style={`--fallback-bg: ${photo.gradient};`}></span>
                )}
              </span>
            ))}
          </div>
        </a>
      </section>
    )}

    <section class="album-section">
      <EditorialSectionHeader title={t('gallery.collections')} titleKey="gallery.collections" icon="i-carbon:folder" />

      <div class="album-grid" aria-label={t('gallery.collections')}>
        {galleryConfig.albums.map(album => {
          const previewPhotos = album.photos.slice(0, 4);
          const leadPhoto = previewPhotos[0];
          const cover = album.coverImage || album.cover || leadPhoto?.thumbnailImage || leadPhoto?.image;

          return (
            <a class="album-card" href={album.href} style={`--album-accent: ${album.accent};`}>
              <span class="album-media" aria-hidden="true">
                <span class="album-main-shot">
                  {cover ? (
                    <img
                      src={cover}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      sizes="(max-width: 640px) 100vw, 420px"
                    />
                  ) : (
                    <span class="image-fallback" style={`--fallback-bg: ${album.gradient};`}></span>
                  )}
                </span>
                <span class="album-thumb-stack">
                  {previewPhotos.slice(1, 4).map(photo => (
                    <span class="album-thumb">
                      {photo.thumbnailImage || photo.image ? (
                        <img
                          src={photo.thumbnailImage || photo.image}
                          alt=""
                          loading="lazy"
                          decoding="async"
                          sizes="96px"
                        />
                      ) : (
                        <span class="image-fallback" style={`--fallback-bg: ${photo.gradient};`}></span>
                      )}
                    </span>
                  ))}
                </span>
              </span>

              <span class="album-card-content">
                <span class="album-label">
                  <i class={album.icon}></i>
                  {album.photoCount} {t('gallery.stats.photos')}
                </span>
                <span class="album-title">{album.title}</span>
                <span class="album-desc">{album.description}</span>
                <span class="album-meta">
                  <span>
                    <i class="i-carbon:calendar"></i>
                    {album.date}
                  </span>
                  <span>
                    <i class="i-carbon:location"></i>
                    {album.location}
                  </span>
                </span>
                <span class="tag-row">
                  {album.tags.slice(0, 4).map(tag => <span>{tag}</span>)}
                </span>
                <span class="view-album">
                  <span data-i18n="gallery.viewAlbum">{t('gallery.viewAlbum')}</span>
                  <i class="i-carbon:arrow-right"></i>
                </span>
              </span>
            </a>
          );
        })}
      </div>
    </section>
  </div>
</EditorialPageLayout>

<style>
  .featured-section {
    margin-bottom: 2rem;
    content-visibility: auto;
    contain-intrinsic-size: auto 24rem;
  }

  .featured-album {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(280px, 0.78fr);
    min-height: 22rem;
    overflow: hidden;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36);
    border-radius: 1.25rem;
    background: var(--md-sys-color-surface-container);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 30px 90px -54px rgba(var(--md-sys-color-shadow-rgb), 0.72);
    isolation: isolate;
  }

  .featured-cover {
    position: relative;
    min-height: 22rem;
    overflow: hidden;
    background: rgba(var(--md-sys-color-surface-container-high-rgb, var(--md-sys-color-surface-container-rgb)), 0.74);
  }

  .featured-cover::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent 0%, rgba(var(--md-sys-color-shadow-rgb), 0.12) 68%, rgba(var(--md-sys-color-shadow-rgb), 0.5) 100%),
      radial-gradient(circle at 18% 18%, color-mix(in srgb, var(--album-accent) 28%, transparent), transparent 32%);
    pointer-events: none;
  }

  .featured-cover img,
  .album-main-shot img,
  .album-thumb img,
  .strip-frame img,
  .image-fallback {
    display: block;
    width: 100%;
    height: 100%;
  }

  .featured-cover img,
  .album-main-shot img,
  .album-thumb img,
  .strip-frame img {
    object-fit: cover;
    transition: transform 0.48s ease;
  }

  .featured-album:hover .featured-cover img,
  .album-card:hover .album-main-shot img {
    transform: scale(1.045);
  }

  .image-fallback {
    background: var(--fallback-bg);
  }

  .featured-content {
    position: relative;
    z-index: 2;
    align-self: end;
    display: grid;
    gap: 0.72rem;
    padding: clamp(1.2rem, 4vw, 2rem);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--album-accent) 14%, transparent), transparent 56%),
      rgba(var(--md-sys-color-surface-rgb), 0.88);
  }

  .featured-label,
  .album-label {
    display: inline-flex;
    align-items: center;
    gap: 0.42rem;
    width: fit-content;
    border-radius: 999px;
    font-size: 0.76rem;
    font-weight: 850;
  }

  .featured-label {
    padding: 0.35rem 0.7rem;
    background: rgba(var(--md-sys-color-primary-rgb), 0.12);
    color: var(--md-sys-color-primary);
  }

  .featured-content h2 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: clamp(1.75rem, 4vw, 2.8rem);
    line-height: 1;
    font-weight: 950;
    letter-spacing: 0;
  }

  .featured-content p {
    margin: 0;
    color: var(--md-sys-color-on-surface-variant);
    line-height: 1.7;
  }

  .featured-meta,
  .featured-action,
  .album-meta,
  .view-album {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .featured-meta {
    flex-wrap: wrap;
    gap: 0.75rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.85rem;
    font-weight: 760;
  }

  .featured-meta span {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
  }

  .featured-action {
    width: fit-content;
    margin-top: 0.4rem;
    padding: 0.7rem 0.9rem;
    border-radius: 999px;
    background: var(--md-sys-color-primary);
    color: var(--md-sys-color-on-primary);
    font-size: 0.86rem;
    font-weight: 850;
  }

  .featured-strip {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    left: 1rem;
    z-index: 3;
    display: flex;
    gap: 0.55rem;
    max-width: calc(58% - 2rem);
    pointer-events: none;
  }

  .strip-frame {
    flex: 0 0 5.6rem;
    height: 4.2rem;
    overflow: hidden;
    border: 2px solid rgba(var(--md-sys-color-surface-bright-rgb), 0.7);
    border-radius: 0.75rem;
    background: rgba(var(--md-sys-color-shadow-rgb), 0.18);
    box-shadow: 0 12px 32px -18px rgba(var(--md-sys-color-shadow-rgb), 0.86);
  }

  .album-section {
    margin-top: 1.5rem;
    content-visibility: auto;
    contain-intrinsic-size: auto 42rem;
  }

  .album-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.15rem;
  }

  .album-card {
    display: grid;
    grid-template-rows: minmax(11rem, 1fr) auto;
    overflow: hidden;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36);
    border-radius: 1rem;
    background: rgba(var(--md-sys-color-surface-container-rgb), 0.7);
    color: inherit;
    text-decoration: none;
    box-shadow: 0 18px 54px -44px rgba(var(--md-sys-color-shadow-rgb), 0.62);
    contain: layout paint style;
    transition: transform 0.28s ease, box-shadow 0.28s ease, border-color 0.28s ease;
  }

  .album-card:hover {
    transform: translateY(-3px);
    border-color: color-mix(in srgb, var(--album-accent) 55%, transparent);
    box-shadow: 0 28px 74px -42px rgba(var(--md-sys-color-shadow-rgb), 0.7);
  }

  .album-media {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(4.6rem, 0.36fr);
    gap: 0.4rem;
    min-height: 11rem;
    padding: 0.5rem;
  }

  .album-main-shot,
  .album-thumb {
    overflow: hidden;
    border-radius: 0.72rem;
    background: rgba(var(--md-sys-color-surface-container-high-rgb, var(--md-sys-color-surface-container-rgb)), 0.78);
    box-shadow: inset 0 0 0 1px rgba(var(--md-sys-color-surface-bright-rgb), 0.14);
  }

  .album-thumb-stack {
    display: grid;
    gap: 0.4rem;
  }

  .album-card-content {
    display: grid;
    gap: 0.58rem;
    padding: 1rem;
  }

  .album-label {
    padding: 0.32rem 0.6rem;
    background: rgba(var(--md-sys-color-primary-rgb), 0.1);
    color: var(--md-sys-color-primary);
  }

  .album-title {
    color: var(--md-sys-color-on-surface);
    font-size: 1.18rem;
    line-height: 1.2;
    font-weight: 900;
  }

  .album-desc {
    display: -webkit-box;
    min-height: 2.7rem;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .album-meta {
    flex-wrap: wrap;
    gap: 0.7rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.78rem;
  }

  .tag-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }

  .tag-row span {
    padding: 0.22rem 0.48rem;
    border-radius: 999px;
    background: rgba(var(--md-sys-color-primary-rgb), 0.1);
    color: var(--md-sys-color-primary);
    font-size: 0.72rem;
    font-weight: 750;
  }

  .view-album {
    width: fit-content;
    margin-top: 0.1rem;
    color: var(--md-sys-color-primary);
    font-size: 0.82rem;
    font-weight: 850;
  }

  @media (max-width: 980px) {
    .featured-album {
      grid-template-columns: 1fr;
    }

    .featured-cover {
      min-height: 24rem;
    }

    .featured-strip {
      max-width: calc(100% - 2rem);
    }

    .album-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .album-grid {
      grid-template-columns: 1fr;
    }

    .featured-cover {
      min-height: 18rem;
    }

    .featured-strip {
      display: none;
    }
  }
</style>
