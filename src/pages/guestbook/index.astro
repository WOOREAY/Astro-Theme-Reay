---
import EditorialPageLayout from '@app/layouts/base/EditorialPageLayout.astro';
import { getCommentsConfig } from '@app/config/site.config';
import Comments from '@features/comments/components/Comments.astro';
import { useI18n } from '@features/i18n/lib/i18n';
import EditorialPageHeader from '@shared/components/EditorialPageHeader.astro';

const { t } = useI18n();
const commentsConfig = getCommentsConfig();
const notes = [
  { icon: 'i-carbon:chat', title: t('guestbook.card.comments'), titleKey: 'guestbook.card.comments', description: t('guestbook.card.commentsDesc'), descriptionKey: 'guestbook.card.commentsDesc' },
  { icon: 'i-carbon:user-follow', title: t('guestbook.card.identity'), titleKey: 'guestbook.card.identity', description: t('guestbook.card.identityDesc'), descriptionKey: 'guestbook.card.identityDesc' },
  { icon: 'i-carbon:email', title: t('guestbook.card.contact'), titleKey: 'guestbook.card.contact', description: t('guestbook.card.contactDesc'), descriptionKey: 'guestbook.card.contactDesc' },
];
const headerStats = [
  { icon: 'i-carbon:connect', labelKey: 'comments.provider', label: t('comments.provider'), value: commentsConfig.provider },
];
---

<EditorialPageLayout title={t('page.title.guestbook')} description={t('guestbook.subtitle')} pageClass="guestbook-page">
  <EditorialPageHeader
    title={t('guestbook.title')}
    description={t('guestbook.subtitle')}
    titleKey="guestbook.title"
    descriptionKey="guestbook.subtitle"
    eyebrow={t('guestbook.eyebrow')}
    eyebrowKey="guestbook.eyebrow"
    icon="i-carbon:send-alt"
    stats={headerStats}
  />

  <aside class="guestbook-notes" aria-label={t('guestbook.eyebrow')}>
    {notes.map((note) => (
      <div>
        <i class={note.icon} aria-hidden="true"></i>
        <span><strong data-i18n={note.titleKey}>{note.title}</strong><small data-i18n={note.descriptionKey}>{note.description}</small></span>
      </div>
    ))}
  </aside>

  <Comments
    mode="guestbook"
    pageKey="/guestbook"
    pageTitle={t('guestbook.title')}
    description={t('guestbook.commentsDesc')}
  />
</EditorialPageLayout>

<style>
  .guestbook-notes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-bottom: 2rem;
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.48);
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }

  .guestbook-notes > div {
    display: grid;
    grid-template-columns: 1.4rem minmax(0, 1fr);
    gap: 0.65rem;
    padding: 0.9rem 1rem;
    border-left: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
  }

  .guestbook-notes > div:first-child { padding-left: 0; border-left: 0; }
  .guestbook-notes i { color: var(--md-sys-color-primary); font-size: 0.9rem; }
  .guestbook-notes strong, .guestbook-notes small { display: block; }
  .guestbook-notes strong { color: var(--md-sys-color-on-surface); font-size: 0.72rem; }
  .guestbook-notes small { margin-top: 0.22rem; color: var(--md-sys-color-on-surface-variant); font-size: 0.65rem; line-height: 1.45; }

  @media (max-width: 720px) {
    .guestbook-notes { grid-template-columns: 1fr; }
    .guestbook-notes > div:nth-child(n) { padding-right: 0; padding-left: 0; border-left: 0; border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.36); }
    .guestbook-notes > div:first-child { border-top: 0; }
  }
</style>
