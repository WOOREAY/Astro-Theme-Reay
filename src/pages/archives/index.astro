---
import ArchiveLayout from '@app/layouts/archives/ArchiveLayout.astro';
import SeriesCard from '@features/archives/components/SeriesCard.astro';
import TagCloud from '@features/archives/components/TagCloud.astro';
import { getAllSeries, getAllTags, getArchiveStats } from '@features/blog/lib/blog';
import { useI18n } from '@features/i18n/lib/i18n';
import EditorialSectionHeader from '@shared/components/EditorialSectionHeader.astro';

const { t } = useI18n();
const stats = await getArchiveStats();
const allTags = await getAllTags();
const allSeries = await getAllSeries();
const topTags = allTags.slice(0, 12);
const topSeries = allSeries.slice(0, 4);
const headerStats = [
  { icon: 'i-carbon:document', labelKey: 'archives.timeline.totalPosts', label: t('archives.timeline.totalPosts'), value: stats.totalPosts },
  { icon: 'i-carbon:tag', labelKey: 'archives.tags.total', label: t('archives.tags.total'), value: stats.totalTags },
  { icon: 'i-carbon:folder', labelKey: 'archives.series.total', label: t('archives.series.total'), value: stats.totalSeries },
  { icon: 'i-carbon:pen', labelKey: 'archives.totalWords', label: t('archives.totalWords'), value: new Intl.NumberFormat('zh-CN', { notation: 'compact' }).format(stats.totalWords) },
];
---

<ArchiveLayout
  title={t('archives.stats.title')}
  description={t('archives.subtitle')}
  titleKey="archives.stats.title"
  descriptionKey="archives.subtitle"
  stats={headerStats}
>
  <div class="archive-overview-grid">
    {topTags.length > 0 && (
      <section class="archive-overview-section archive-tags">
        <EditorialSectionHeader
          title={t('archives.hotTags')}
          titleKey="archives.hotTags"
          icon="i-carbon:tag"
          actionHref="/archives/tags"
          actionLabel={t('archives.viewAllTags')}
          actionKey="archives.viewAllTags"
        />
        <TagCloud tags={topTags} />
      </section>
    )}

    {topSeries.length > 0 && (
      <section class="archive-overview-section archive-series">
        <EditorialSectionHeader
          title={t('archives.series')}
          titleKey="archives.series"
          icon="i-carbon:folder"
          actionHref="/archives/series"
          actionLabel={t('archives.viewAllSeries')}
          actionKey="archives.viewAllSeries"
        />
        <div>{topSeries.map((item) => <SeriesCard {...item} />)}</div>
      </section>
    )}
  </div>

  <section class="archive-explore">
    <EditorialSectionHeader
      title={t('archives.exploreMore')}
      titleKey="archives.exploreMore"
      icon="i-carbon:compass"
    />
    <div class="archive-explore-links">
      <a href="/archives/timeline">
        <i class="i-carbon:time" aria-hidden="true"></i>
        <span><strong data-i18n="archives.timeline">{t('archives.timeline')}</strong><small data-i18n="archives.timeline.desc">{t('archives.timeline.desc')}</small></span>
        <i class="i-carbon:arrow-right" aria-hidden="true"></i>
      </a>
      <a href="/blog">
        <i class="i-carbon:blog" aria-hidden="true"></i>
        <span><strong data-i18n="archives.blogList">{t('archives.blogList')}</strong><small data-i18n="archives.blogList.desc">{t('archives.blogList.desc')}</small></span>
        <i class="i-carbon:arrow-right" aria-hidden="true"></i>
      </a>
    </div>
  </section>
</ArchiveLayout>

<style>
  .archive-overview-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(20rem, 0.95fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }

  .archive-overview-section,
  .archive-explore {
    min-width: 0;
  }

  .archive-explore {
    margin-top: clamp(2.4rem, 6vw, 4rem);
  }

  .archive-explore-links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.5);
  }

  .archive-explore-links a {
    display: grid;
    grid-template-columns: 1.8rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem;
    padding: 1rem 0.75rem;
    color: inherit;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44);
  }

  .archive-explore-links a:first-child {
    padding-left: 0;
    padding-right: 1.25rem;
    border-right: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44);
  }

  .archive-explore-links a:last-child {
    padding-right: 0;
    padding-left: 1.25rem;
  }

  .archive-explore-links a > i {
    color: var(--md-sys-color-primary);
    font-size: 1rem;
  }

  .archive-explore-links span {
    min-width: 0;
  }

  .archive-explore-links strong,
  .archive-explore-links small {
    display: block;
  }

  .archive-explore-links strong {
    font-size: 0.88rem;
  }

  .archive-explore-links small {
    margin-top: 0.2rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.7rem;
    line-height: 1.45;
  }

  .archive-explore-links a:hover {
    color: var(--md-sys-color-primary);
    background: rgba(var(--md-sys-color-primary-rgb), 0.055);
  }

  @media (max-width: 880px) {
    .archive-overview-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 620px) {
    .archive-explore-links {
      grid-template-columns: 1fr;
    }

    .archive-explore-links a:nth-child(n) {
      padding-right: 0;
      padding-left: 0;
      border-right: 0;
    }
  }
</style>
