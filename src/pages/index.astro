---
/**
 * Home Page - Fullscreen scrolling display
 * Layout: FullscreenLayout (fullscreen layout with fixed header)
 * Components: 
 *   - PageScrollContainer (fullscreen scroll container)
 *   - FullpageSection (scroll sections)
 *   - HeroSection, PostsSection, ProjectsSection, AboutSection, SiteInfoSection (section content)
 */
import FullscreenLayout from '@app/layouts/home/FullscreenLayout.astro';
import PageScrollContainer from '@shared/components/layout/PageScrollContainer.astro';
import FullPageSection from '@shared/components/layout/FullPageSection.astro';
import HeroSection from '@features/home/components/HeroSection.astro';
import PostsSection from '@features/home/components/PostsSection.astro';
import ProjectsSection from '@features/home/components/ProjectsSection.astro';
import AboutSection from '@features/home/components/AboutSection.astro';
import SiteInfoSection from '@features/home/components/SiteInfoSection.astro';
import { getFeaturesConfig } from '@app/config/site.config';

const features = getFeaturesConfig();
const sections = [
  { id: 'hero', label: 'Hero' },
  { id: 'posts', label: 'Posts' },
  ...(features.integrations.githubProjects ? [{ id: 'projects', label: 'Projects' }] : []),
  { id: 'about', label: 'About' },
  { id: 'site', label: 'Site' },
];
const homeLayout = features.home.layout;
---

<FullscreenLayout title="Home">
  <PageScrollContainer sections={sections} mode={homeLayout}>
    <!-- Section 1: Hero -->
    <FullPageSection sectionId="hero">
      <HeroSection />
    </FullPageSection>

    <!-- Section 2: Latest posts -->
    <FullPageSection sectionId="posts">
      <PostsSection />
    </FullPageSection>

    <!-- Section 3: Featured projects -->
    {features.integrations.githubProjects && (
      <FullPageSection sectionId="projects">
        <ProjectsSection />
      </FullPageSection>
    )}

    <!-- Section 4: Personal info -->
    <FullPageSection sectionId="about">
      <AboutSection />
    </FullPageSection>

    <!-- Section 5: Site info (includes Footer) -->
    <FullPageSection sectionId="site">
      <SiteInfoSection />
    </FullPageSection>
  </PageScrollContainer>
</FullscreenLayout>
