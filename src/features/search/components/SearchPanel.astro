---
import '@pagefind/default-ui/css/ui.css';
import { useI18n } from '@features/i18n/lib/i18n';

const { t } = useI18n();
---

<section class="search-page" data-pagefind-ignore>
  <div class="search-shortcut">
    <i class="i-carbon:keyboard"></i>
    <span data-i18n="search.shortcut">{t('search.shortcut')}</span>
    <kbd>/</kbd>
  </div>

  <div class="search-panel" data-pagefind-search aria-live="polite"></div>
</section>

<script>
  import { initSearchRuntime } from '@features/search/client/search';

  initSearchRuntime();
</script>

<style>
  .search-page {
    --pagefind-ui-primary: var(--md-sys-color-primary);
    --pagefind-ui-text: var(--md-sys-color-on-surface);
    --pagefind-ui-background: rgba(var(--md-sys-color-surface-container-rgb), 0.72);
    --pagefind-ui-border: rgba(var(--md-sys-color-outline-variant-rgb), 0.55);
    --pagefind-ui-tag: var(--md-sys-color-secondary-container);
    width: min(100%, 62rem);
    margin: 0 auto;
  }

  .search-shortcut {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0 0 0.8rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.8rem;
  }

  .search-shortcut kbd {
    padding: 0.12rem 0.42rem;
    border: 1px solid var(--reay-surface-border);
    border-radius: 0.4rem;
    background: var(--reay-surface-bg);
    box-shadow: var(--reay-shadow-soft);
  }

  .search-panel {
    min-height: 18rem;
    padding: clamp(1rem, 3vw, 1.75rem);
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.5);
    border-radius: 1rem;
    background: var(--md-sys-color-surface-container-low);
  }

  .search-panel :global(.pagefind-ui__search-input) {
    border-radius: 1rem;
    box-shadow: none;
  }

  .search-panel :global(.pagefind-ui__result) {
    border-color: var(--reay-surface-border);
  }
</style>
