---
/** Visual link portrait with a blurred avatar backdrop and optional site preview. */
import { getLinksConfig } from '@app/config/site.config';
import type { FriendLink } from '@app/config/links.config';

interface Props { link: FriendLink; }
const { link } = Astro.props;
const previews = getLinksConfig().previews;
const previewUrl = link.screenshot || (previews.provider === 'microlink'
  ? `${previews.endpoint}?url=${encodeURIComponent(link.url)}&screenshot=true&meta=false&embed=screenshot.url`
  : '');
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class="link-portrait-card"
  data-link-card
  data-category={link.category}
  data-featured={link.featured}
  data-preview-src={previewUrl || undefined}
>
  <span class="link-backdrop" aria-hidden="true">
    <img src={link.avatar} alt="" loading="lazy" decoding="async" />
  </span>
  <span class="link-preview" aria-hidden="true">
    <img alt="" data-link-preview loading="lazy" decoding="async" />
  </span>
  <span class="link-scrim" aria-hidden="true"></span>

  <img src={link.avatar} alt="" class="link-avatar" loading="lazy" decoding="async" />
  <span class="link-copy">
    <span class="link-heading">
      <strong>{link.name}</strong>
      {link.featured && <i class="i-carbon:star-filled" aria-label="Featured"></i>}
    </span>
    <span>{link.description}</span>
  </span>
  <span class="link-visit" aria-hidden="true">
    <i class="i-carbon:arrow-up-right"></i>
  </span>
</a>

<style>
  .link-portrait-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) auto;
    gap: 0.9rem;
    align-items: center;
    min-height: 7.2rem;
    overflow: hidden;
    padding: 1rem;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
    border-radius: 1.05rem;
    background: var(--md-sys-color-surface-container-low);
    color: inherit;
    box-shadow: 0 20px 52px -42px rgba(var(--md-sys-color-shadow-rgb), 0.74);
    contain: layout paint;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .link-portrait-card:hover {
    border-color: rgba(var(--md-sys-color-primary-rgb), 0.42);
    box-shadow: 0 28px 68px -42px rgba(var(--md-sys-color-shadow-rgb), 0.82);
    transform: translateY(-2px);
  }

  .link-backdrop,
  .link-preview,
  .link-scrim {
    position: absolute;
    inset: 0;
    z-index: -3;
    pointer-events: none;
  }

  .link-backdrop {
    overflow: hidden;
    opacity: 0.28;
  }

  .link-backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: blur(22px) saturate(1.2);
    transform: scale(1.5);
  }

  .link-preview {
    z-index: -2;
    overflow: hidden;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .link-portrait-card.has-preview .link-preview {
    opacity: 0.22;
  }

  .link-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .link-scrim {
    z-index: -1;
    background:
      linear-gradient(100deg, rgba(var(--md-sys-color-surface-rgb), 0.96) 0%, rgba(var(--md-sys-color-surface-rgb), 0.88) 58%, rgba(var(--md-sys-color-surface-rgb), 0.72) 100%),
      linear-gradient(135deg, rgba(var(--md-sys-color-primary-rgb), 0.08), transparent 62%);
  }

  .link-avatar {
    width: 3.2rem;
    height: 3.2rem;
    border: 1px solid rgba(var(--md-sys-color-surface-bright-rgb), 0.28);
    border-radius: 0.95rem;
    object-fit: cover;
    background: var(--md-sys-color-surface-container-high);
    box-shadow: 0 12px 30px -20px rgba(var(--md-sys-color-shadow-rgb), 0.82);
  }

  .link-copy,
  .link-heading {
    min-width: 0;
  }

  .link-heading {
    display: flex;
    align-items: center;
    gap: 0.42rem;
  }

  .link-heading strong {
    overflow: hidden;
    color: var(--md-sys-color-on-surface);
    font-size: 0.92rem;
    font-weight: 860;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-heading i {
    color: var(--md-sys-color-tertiary);
    font-size: 0.72rem;
  }

  .link-copy > span:last-child {
    display: -webkit-box;
    margin-top: 0.3rem;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.72rem;
    line-height: 1.5;
  }

  .link-visit {
    display: grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.46);
    border-radius: 999px;
    color: var(--md-sys-color-primary);
    background: rgba(var(--md-sys-color-surface-container-high-rgb), 0.64);
    font-size: 0.82rem;
    transition: transform 0.22s ease, background 0.22s ease;
  }

  .link-portrait-card:hover .link-visit {
    background: var(--md-sys-color-primary-container);
    transform: translate(2px, -2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .link-portrait-card,
    .link-visit {
      transition: none;
    }
  }
</style>
