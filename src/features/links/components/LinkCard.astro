---
/** Compact link entry; remote preview remains optional and decorative. */
import { getLinksConfig } from '@app/config/site.config';
import type { FriendLink } from '@app/config/links.config';

interface Props { link: FriendLink; }
const { link } = Astro.props;
const previews = getLinksConfig().previews;
const previewUrl = link.screenshot || (previews.provider === 'microlink'
  ? `${previews.endpoint}?url=${encodeURIComponent(link.url)}&screenshot=true&meta=false&embed=screenshot.url`
  : '');
---

<a
  href={link.url}
  target="_blank"
  rel="noopener noreferrer"
  class="link-card"
  data-link-card
  data-category={link.category}
  data-featured={link.featured}
  data-preview-src={previewUrl || undefined}
>
  <span class="link-preview" aria-hidden="true">
    <img alt="" data-link-preview loading="lazy" decoding="async" />
  </span>
  <img src={link.avatar} alt="" class="link-avatar" loading="lazy" decoding="async" />
  <span class="link-copy">
    <span class="link-heading">
      <strong>{link.name}</strong>
      {link.featured && <i class="i-carbon:star-filled" aria-label="Featured"></i>}
    </span>
    <span>{link.description}</span>
  </span>
  <i class="i-carbon:arrow-up-right link-arrow" aria-hidden="true"></i>
</a>

<style>
  .link-card {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 2.6rem minmax(0, 1fr) auto;
    gap: 0.8rem;
    align-items: center;
    min-height: 5.4rem;
    overflow: hidden;
    padding: 0.8rem 0.9rem;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42);
    color: inherit;
  }

  :global(body.layout-default) .link-card {
    border-width: 0 !important;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.42) !important;
    border-radius: 0 !important;
    background: transparent !important;
    box-shadow: none !important;
    transform: none !important;
  }

  .link-card:hover {
    background: linear-gradient(110deg, rgba(var(--md-sys-color-primary-rgb), 0.08), transparent 74%);
  }

  .link-preview {
    position: absolute;
    inset: 0 0 0 58%;
    z-index: -1;
    overflow: hidden;
    opacity: 0;
    mask-image: linear-gradient(90deg, transparent, black);
  }

  .link-card.has-preview .link-preview {
    opacity: 0.22;
  }

  .link-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .link-avatar {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 0.78rem;
    object-fit: cover;
    background: var(--md-sys-color-surface-container-high);
    box-shadow: 0 8px 24px -18px rgba(var(--md-sys-color-shadow-rgb), 0.72);
  }

  .link-copy,
  .link-heading {
    min-width: 0;
  }

  .link-heading {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .link-heading strong {
    overflow: hidden;
    color: var(--md-sys-color-on-surface);
    font-size: 0.86rem;
    font-weight: 820;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .link-heading i {
    color: var(--md-sys-color-tertiary);
    font-size: 0.7rem;
  }

  .link-copy > span:last-child {
    display: -webkit-box;
    margin-top: 0.2rem;
    overflow: hidden;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.68rem;
    line-height: 1.45;
  }

  .link-arrow {
    color: var(--md-sys-color-primary);
    font-size: 0.82rem;
    transition: transform 0.2s ease;
  }

  .link-card:hover .link-arrow {
    transform: translate(2px, -2px);
  }
</style>
