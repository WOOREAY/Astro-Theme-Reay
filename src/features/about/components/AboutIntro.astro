---
/** Compact personal introduction sourced from the central user profile. */
import { getLocalizedUserContent, getUserProfile } from '@app/config/site.config';
import { useI18n } from '@features/i18n/lib/i18n';

const { currentLang } = useI18n();
const user = getUserProfile();
const content = getLocalizedUserContent(currentLang);
---

<section class="intro-section" data-about-intro>
  <div class="intro-avatar">
    <img src={user.avatar} alt={user.name} width="512" height="512" decoding="async" />
  </div>
  <div class="intro-content">
    <p class="intro-greeting" data-user-content="greeting">{content.greeting}</p>
    <h2>{user.name}</h2>
    <p class="intro-tagline" data-user-content="tagline">{content.tagline}</p>
    <p class="intro-description" data-user-content="bio">{content.bio}</p>
  </div>
</section>

<style>
  .intro-section {
    display: grid;
    grid-template-columns: 6.5rem minmax(0, 1fr);
    gap: clamp(1.25rem, 4vw, 2.5rem);
    align-items: center;
    margin-bottom: 2.4rem;
    padding: 0 0 2rem;
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.48);
  }

  .intro-avatar {
    position: relative;
    width: 6.5rem;
    height: 6.5rem;
  }

  .intro-avatar::after {
    content: '';
    position: absolute;
    right: -0.35rem;
    bottom: -0.35rem;
    width: 2.3rem;
    height: 2.3rem;
    border: 1px solid rgba(var(--md-sys-color-primary-rgb), 0.42);
    border-radius: 0.85rem;
    background: rgba(var(--md-sys-color-primary-container-rgb), 0.48);
  }

  img {
    display: block;
    width: 100%;
    height: 100%;
    border-radius: 1.35rem;
    object-fit: cover;
    box-shadow: 0 16px 48px -32px rgba(var(--md-sys-color-shadow-rgb), 0.7);
  }

  .intro-content {
    min-width: 0;
  }

  .intro-greeting {
    margin: 0 0 0.22rem;
    color: var(--md-sys-color-primary);
    font-size: 0.68rem;
    font-weight: 850;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h2 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: clamp(1.55rem, 3vw, 2rem);
    font-weight: 900;
    line-height: 1.1;
  }

  .intro-tagline {
    margin: 0.42rem 0 0;
    color: var(--md-sys-color-on-surface);
    font-size: 0.88rem;
    font-weight: 730;
  }

  .intro-description {
    max-width: 48rem;
    margin: 0.68rem 0 0;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.83rem;
    line-height: 1.7;
  }

  @media (max-width: 520px) {
    .intro-section {
      grid-template-columns: 4.5rem minmax(0, 1fr);
      gap: 1rem;
    }

    .intro-avatar {
      width: 4.5rem;
      height: 4.5rem;
    }

    .intro-avatar::after {
      width: 1.6rem;
      height: 1.6rem;
      border-radius: 0.55rem;
    }
  }
</style>
