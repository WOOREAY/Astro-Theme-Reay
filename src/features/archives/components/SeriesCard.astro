---
/** Open editorial entry for one article series. */
import type { CollectionEntry } from 'astro:content';
import { getSeriesUrl } from '@features/blog/lib/blog';
import { useI18n } from '@features/i18n/lib/i18n';

interface Props {
  series: string;
  count: number;
  posts: CollectionEntry<'blog'>[];
}

const { series, count, posts = [] } = Astro.props;
const { t } = useI18n();
const latestPost = [...posts].sort(
  (left, right) => right.data.publishDate.getTime() - left.data.publishDate.getTime()
)[0];
const topTags = [...new Set(posts.flatMap((post) => post.data.tags))].slice(0, 3);
---

<article class="series-entry" data-series-entry>
  <a href={getSeriesUrl(series)} data-astro-prefetch="hover">
    <span class="series-icon"><i class="i-carbon:folder" aria-hidden="true"></i></span>
    <span class="series-copy">
      <span class="series-kicker">
        {count} <span data-i18n="archives.postsCount">{t('archives.postsCount')}</span>
      </span>
      <h3>{series}</h3>
      {latestPost && <p>{latestPost.data.title}</p>}
      {topTags.length > 0 && (
        <span class="series-tags">{topTags.map((tag) => <span>#{tag}</span>)}</span>
      )}
    </span>
    {latestPost && (
      <time
        datetime={latestPost.data.publishDate.toISOString()}
        data-i18n-date={latestPost.data.publishDate.toISOString()}
        data-i18n-date-format="short"
      >
        {latestPost.data.publishDate.toLocaleDateString('zh-CN')}
      </time>
    )}
    <i class="i-carbon:arrow-up-right series-arrow" aria-hidden="true"></i>
  </a>
</article>

<style>
  .series-entry {
    border-bottom: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.44);
  }

  .series-entry:first-child {
    border-top: 1px solid rgba(var(--md-sys-color-outline-variant-rgb), 0.5);
  }

  .series-entry > a {
    display: grid;
    grid-template-columns: 2.25rem minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 0.9rem;
    padding: 1rem 0.6rem;
    color: inherit;
  }

  .series-entry > a:hover {
    padding-right: 0.35rem;
    padding-left: 0.85rem;
    background: linear-gradient(90deg, rgba(var(--md-sys-color-primary-rgb), 0.065), transparent 75%);
  }

  .series-icon {
    display: grid;
    place-items: center;
    width: 2.1rem;
    height: 2.1rem;
    color: var(--md-sys-color-primary);
    background: var(--md-sys-color-primary-container);
    border-radius: 0.7rem;
  }

  .series-copy {
    min-width: 0;
  }

  .series-kicker {
    display: block;
    margin-bottom: 0.22rem;
    color: var(--md-sys-color-primary);
    font-size: 0.64rem;
    font-weight: 820;
    letter-spacing: 0.045em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    color: var(--md-sys-color-on-surface);
    font-size: 1rem;
    font-weight: 850;
  }

  p {
    margin: 0.28rem 0 0;
    overflow: hidden;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.74rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .series-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.38rem;
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.64rem;
  }

  time {
    color: var(--md-sys-color-on-surface-variant);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .series-arrow {
    color: var(--md-sys-color-primary);
    font-size: 0.88rem;
  }

  @media (max-width: 600px) {
    .series-entry > a {
      grid-template-columns: 2.25rem minmax(0, 1fr) auto;
      padding-right: 0;
      padding-left: 0;
    }

    time {
      display: none;
    }
  }
</style>
