---
import { useI18n } from '@features/i18n/lib/i18n';

const { t } = useI18n();
---

<a
  href="/search"
  class="header-tool-button"
  aria-label={t('nav.search')}
  title={t('nav.search')}
  data-reay-prefetch="idle"
  data-astro-prefetch="load"
>
  <i class="i-carbon:search" aria-hidden="true"></i>
</a>
